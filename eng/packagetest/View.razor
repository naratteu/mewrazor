@inherits HookComponent
@* Every tag here must resolve to a component compiled into the package, not to one the
   consumer regenerated for itself, and every hook must come from the packaged assembly. *@
@{
    var (items, _) = UseState<string[]>(["one", "two"]);

    var view = UseMemo(() => ItemsView.Create(items), items);

    UseEffect(() => { }, items);

    var seen = UseRef(0);
    var noop = UseCallback(() => { seen.Value++; });
}

<MewStackPanel Spacing="8" Margin="4">
    <MewTextBlock Text="packaged" FontWeight="FontWeight.Bold" />
    <MewButton Text="ok" />
    <MewListBox ItemsSource="view" />
    <MewButton Text="hooked" OnClick="noop" />
    <MewGridView />
</MewStackPanel>
