<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- BL0006: RenderTree types carry no stability guarantee outside Blazor. Depending on them
         is the whole design, so the warning is acknowledged once here instead of at every use. -->
    <NoWarn>$(NoWarn);BL0006</NoWarn>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

    <PackageId>Naratteu.MewUI.Razor</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Description>Write MewUI desktop applications as Razor components.</Description>
    <Authors>naratteu</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/naratteu/mewrazor</RepositoryUrl>
    <PackageTags>mewui;razor;blazor;desktop;ui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI.Core" Version="0.21.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time only, and deliberately NOT packed: the components it produces are already
         compiled into this assembly. Shipping it as an analyzer makes it run again in every
         consumer, duplicating all 69 components and shadowing the hand-written partials. -->
    <ProjectReference Include="../Naratteu.MewUI.Razor.Generator/Naratteu.MewUI.Razor.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
