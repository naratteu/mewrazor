<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

    <PackageId>Naratteu.MewUI.Razor</PackageId>
    <Description>Write MewUI desktop applications as Razor components.</Description>
    <Authors>naratteu</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/naratteu/mewrazor</RepositoryUrl>
    <PackageTags>mewui;razor;blazor;desktop;ui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <!-- The generator ships inside the package so consumers get the components. -->
    <None Include="../Naratteu.MewUI.Razor.Generator/bin/$(Configuration)/netstandard2.0/Naratteu.MewUI.Razor.Generator.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI.Core" Version="0.21.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Naratteu.MewUI.Razor.Generator/Naratteu.MewUI.Razor.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
