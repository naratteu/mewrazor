<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Razor components without any web stack: no static web assets, no MVC support. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI.MacOS" Version="0.21.1" />
    <ProjectReference Include="../../src/Naratteu.MewUI.Razor/Naratteu.MewUI.Razor.csproj" />
  </ItemGroup>

</Project>
