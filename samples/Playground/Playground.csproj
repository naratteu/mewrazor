<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Razor components without any web stack: no static web assets, no MVC support. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI.MacOS" Version="0.21.1" />
    <ProjectReference Include="../../src/Naratteu.MewUI.Razor/Naratteu.MewUI.Razor.csproj" />

    <!-- A package reference would bring this along on its own; a project reference does not,
         so the sample asks for the same build-time checking a consumer gets. -->
    <ProjectReference Include="../../src/Naratteu.MewUI.Razor.Analyzers/Naratteu.MewUI.Razor.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
